{
  "openapi": "3.1.0",
  "info": {
    "title": "RetailFixIt Vendor Dispatch API",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "https://<functionAppName>.azurewebsites.net/api"
    }
  ],
  "paths": {
    "/jobs": {
      "post": {
        "summary": "Create a job",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreateResponse"
                }
              }
            }
          }
        },
        "security": []
      },
      "get": {
        "summary": "List jobs",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobListItem"
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/jobs/{jobId}": {
      "get": {
        "summary": "Get a job",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobEvent"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/jobs/{jobId}/recommendation": {
      "get": {
        "summary": "Get a job's scoring recommendation",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreFactors"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/jobs/{jobId}/assignment": {
      "post": {
        "summary": "Accept or override the recommendation",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssignmentResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/jobs/{jobId}/completion": {
      "post": {
        "summary": "Record a job outcome (feeds the retraining loop)",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobCompletionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCompletionResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/jobs/{jobId}/audit": {
      "get": {
        "summary": "Get the full audit trail for a job",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/vendors": {
      "get": {
        "summary": "List all vendors",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VendorProfile"
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/jobs/{jobId}/replay": {
      "post": {
        "summary": "Re-publish JobCreated for an already-known job",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreateResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/admin/seed": {
      "post": {
        "summary": "Seed and dispatch every fixture job in data/jobs.json",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeedResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "functionKey": []
          }
        ]
      }
    },
    "/jobs/{jobId}/dispatch": {
      "post": {
        "summary": "Publish JobCreated for an already-known job (saga demo hook)",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DispatchResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "functionKey": []
          }
        ]
      }
    },
    "/jobs/{jobId}/orchestration": {
      "get": {
        "summary": "Get the Durable orchestration status for a job",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationStatusResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "functionKey": []
          }
        ]
      }
    },
    "/jobs/{jobId}/vendor-response": {
      "post": {
        "summary": "Raise the saga's VendorResponse external event",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VendorResponseBody"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted"
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "DispatchInfo": {
        "properties": {
          "excludedVendorIds": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Excludedvendorids",
            "type": "array"
          },
          "allowAutoAssign": {
            "default": true,
            "title": "Allowautoassign",
            "type": "boolean"
          }
        },
        "title": "DispatchInfo",
        "type": "object"
      },
      "GeoPoint": {
        "properties": {
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "title": "GeoPoint",
        "type": "object"
      },
      "JobDetails": {
        "properties": {
          "tradeCategory": {
            "title": "Tradecategory",
            "enum": [
              "HVAC",
              "PLUMBING",
              "ELECTRICAL",
              "REFRIGERATION",
              "ELEVATOR"
            ],
            "type": "string"
          },
          "priority": {
            "title": "Priority",
            "type": "string"
          },
          "requiresCertification": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Requirescertification",
            "type": "array"
          },
          "requiresEquipment": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Requiresequipment",
            "type": "array"
          },
          "estimatedLabourHours": {
            "title": "Estimatedlabourhours",
            "type": "number"
          },
          "notToExceedUsd": {
            "title": "Nottoexceedusd",
            "type": "number"
          },
          "isRecall": {
            "default": false,
            "title": "Isrecall",
            "type": "boolean"
          }
        },
        "required": [
          "tradeCategory",
          "priority",
          "estimatedLabourHours",
          "notToExceedUsd"
        ],
        "title": "JobDetails",
        "type": "object"
      },
      "JobEventData": {
        "properties": {
          "customerId": {
            "title": "Customerid",
            "type": "string"
          },
          "accountTier": {
            "title": "Accounttier",
            "type": "string"
          },
          "site": {
            "$ref": "#/components/schemas/SiteInfo"
          },
          "job": {
            "$ref": "#/components/schemas/JobDetails"
          },
          "sla": {
            "$ref": "#/components/schemas/SlaInfo"
          },
          "risk": {
            "$ref": "#/components/schemas/RiskInfo"
          },
          "dispatch": {
            "$ref": "#/components/schemas/DispatchInfo"
          }
        },
        "required": [
          "customerId",
          "accountTier",
          "site",
          "job",
          "sla",
          "risk",
          "dispatch"
        ],
        "title": "JobEventData",
        "type": "object"
      },
      "RiskInfo": {
        "properties": {
          "riskTier": {
            "title": "Risktier",
            "type": "string"
          },
          "safetyRisk": {
            "default": false,
            "title": "Safetyrisk",
            "type": "boolean"
          },
          "revenueAtRiskUsd": {
            "default": 0,
            "title": "Revenueatriskusd",
            "type": "number"
          }
        },
        "required": [
          "riskTier"
        ],
        "title": "RiskInfo",
        "type": "object"
      },
      "SiteInfo": {
        "properties": {
          "siteId": {
            "title": "Siteid",
            "type": "string"
          },
          "geo": {
            "$ref": "#/components/schemas/GeoPoint"
          },
          "addressRef": {
            "title": "Addressref",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "siteId",
          "geo",
          "addressRef",
          "timezone"
        ],
        "title": "SiteInfo",
        "type": "object"
      },
      "SlaInfo": {
        "properties": {
          "responseDueUtc": {
            "title": "Responsedueutc",
            "type": "string"
          },
          "resolutionDueUtc": {
            "title": "Resolutiondueutc",
            "type": "string"
          },
          "sensitivity": {
            "title": "Sensitivity",
            "type": "string"
          },
          "breachPenaltyUsd": {
            "default": 0,
            "title": "Breachpenaltyusd",
            "type": "number"
          }
        },
        "required": [
          "responseDueUtc",
          "resolutionDueUtc",
          "sensitivity"
        ],
        "title": "SlaInfo",
        "type": "object"
      },
      "JobCreateRequest": {
        "description": "POST /jobs request body. jobId/correlationId/occurredAtUtc are\nauto-generated by the server when omitted.",
        "properties": {
          "jobId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Jobid"
          },
          "correlationId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Correlationid"
          },
          "occurredAtUtc": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Occurredatutc"
          },
          "data": {
            "$ref": "#/components/schemas/JobEventData"
          }
        },
        "required": [
          "data"
        ],
        "title": "JobCreateRequest",
        "type": "object"
      },
      "JobCreateResponse": {
        "properties": {
          "jobId": {
            "title": "Jobid",
            "type": "string"
          },
          "correlationId": {
            "title": "Correlationid",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "scoringRunId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Scoringrunid"
          }
        },
        "required": [
          "jobId",
          "correlationId",
          "status"
        ],
        "title": "JobCreateResponse",
        "type": "object"
      },
      "JobListItem": {
        "properties": {
          "jobId": {
            "title": "Jobid",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          },
          "correlationId": {
            "title": "Correlationid",
            "type": "string"
          },
          "occurredAtUtc": {
            "title": "Occurredatutc",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "jobId",
          "type",
          "correlationId",
          "occurredAtUtc",
          "status"
        ],
        "title": "JobListItem",
        "type": "object"
      },
      "JobEvent": {
        "description": "CloudEvents-shaped envelope. `type` distinguishes lifecycle stage\n(job.created.v1, job.assigned.v1, job.completed.v1, ...).",
        "properties": {
          "type": {
            "default": "job.created.v1",
            "title": "Type",
            "type": "string"
          },
          "jobId": {
            "title": "Jobid",
            "type": "string"
          },
          "correlationId": {
            "title": "Correlationid",
            "type": "string"
          },
          "occurredAtUtc": {
            "title": "Occurredatutc",
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/JobEventData"
          }
        },
        "required": [
          "jobId",
          "correlationId",
          "occurredAtUtc",
          "data"
        ],
        "title": "JobEvent",
        "type": "object"
      },
      "Binding": {
        "properties": {
          "rulesetVersion": {
            "title": "Rulesetversion",
            "type": "string"
          },
          "modelName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Modelname"
          },
          "modelVersion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Modelversion"
          },
          "scoringMode": {
            "title": "Scoringmode",
            "type": "string"
          },
          "mlTrustFactor": {
            "title": "Mltrustfactor",
            "type": "number"
          },
          "degradedReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Degradedreason"
          }
        },
        "required": [
          "rulesetVersion",
          "scoringMode",
          "mlTrustFactor"
        ],
        "title": "Binding",
        "type": "object"
      },
      "CandidateSummary": {
        "properties": {
          "vendorsInNetwork": {
            "title": "Vendorsinnetwork",
            "type": "integer"
          },
          "afterHardFilter": {
            "title": "Afterhardfilter",
            "type": "integer"
          },
          "exclusions": {
            "additionalProperties": {
              "type": "integer"
            },
            "default": {},
            "title": "Exclusions",
            "type": "object"
          }
        },
        "required": [
          "vendorsInNetwork",
          "afterHardFilter"
        ],
        "title": "CandidateSummary",
        "type": "object"
      },
      "CostPrediction": {
        "properties": {
          "p50": {
            "title": "P50",
            "type": "number"
          },
          "p90": {
            "title": "P90",
            "type": "number"
          }
        },
        "required": [
          "p50",
          "p90"
        ],
        "title": "CostPrediction",
        "type": "object"
      },
      "Factor": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "shap": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Shap"
          },
          "ruleId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ruleid"
          },
          "contributionPct": {
            "title": "Contributionpct",
            "type": "number"
          },
          "raw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Raw"
          },
          "evidence": {
            "title": "Evidence",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "contributionPct",
          "evidence"
        ],
        "title": "Factor",
        "type": "object"
      },
      "PredictionValue": {
        "properties": {
          "value": {
            "title": "Value",
            "type": "number"
          },
          "ci90": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ci90"
          }
        },
        "required": [
          "value"
        ],
        "title": "PredictionValue",
        "type": "object"
      },
      "Predictions": {
        "properties": {
          "pSlaMet": {
            "$ref": "#/components/schemas/PredictionValue"
          },
          "pFirstTimeFix": {
            "$ref": "#/components/schemas/PredictionValue"
          },
          "pAcceptWithin15m": {
            "$ref": "#/components/schemas/PredictionValue"
          },
          "expectedCostUsd": {
            "$ref": "#/components/schemas/CostPrediction"
          }
        },
        "required": [
          "pSlaMet",
          "pFirstTimeFix",
          "pAcceptWithin15m",
          "expectedCostUsd"
        ],
        "title": "Predictions",
        "type": "object"
      },
      "RankedVendor": {
        "properties": {
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "vendorId": {
            "title": "Vendorid",
            "type": "string"
          },
          "finalScore": {
            "title": "Finalscore",
            "type": "number"
          },
          "ruleScore": {
            "title": "Rulescore",
            "type": "number"
          },
          "mlScore": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Mlscore"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "confidenceBand": {
            "title": "Confidenceband",
            "type": "string"
          },
          "predictions": {
            "$ref": "#/components/schemas/Predictions"
          },
          "factors": {
            "items": {
              "$ref": "#/components/schemas/Factor"
            },
            "title": "Factors",
            "type": "array"
          },
          "counterfactual": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Counterfactual"
          },
          "rationale": {
            "$ref": "#/components/schemas/Rationale"
          },
          "automationEligible": {
            "title": "Automationeligible",
            "type": "boolean"
          },
          "blockingGates": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Blockinggates",
            "type": "array"
          }
        },
        "required": [
          "rank",
          "vendorId",
          "finalScore",
          "ruleScore",
          "confidence",
          "confidenceBand",
          "predictions",
          "factors",
          "rationale",
          "automationEligible"
        ],
        "title": "RankedVendor",
        "type": "object"
      },
      "Rationale": {
        "properties": {
          "template": {
            "title": "Template",
            "type": "string"
          },
          "narrative": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Narrative"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "groundednessCheck": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Groundednesscheck"
          },
          "fallbackUsed": {
            "default": false,
            "title": "Fallbackused",
            "type": "boolean"
          }
        },
        "required": [
          "template",
          "source"
        ],
        "title": "Rationale",
        "type": "object"
      },
      "ScoreFactors": {
