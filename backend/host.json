{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": { "isEnabled": true, "excludedTypes": "Request" }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "durableTask": {
      "hubName": "retailfixit",
      "maxQueuePollingInterval": "00:00:05",
      "maxConcurrentActivityFunctions": 4,
      "maxConcurrentOrchestratorFunctions": 4,
      "storageProvider": {
        "partitionCount": 1
      }
    }
  }
}
