{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "python",

    "SERVICE_BUS_NAMESPACE": "sb-retailfixit-app.servicebus.windows.net",

    "SQL_CONNECTION_STRING": "@Microsoft.KeyVault(SecretUri=https://kv-retailfixit.vault.azure.net/secrets/sql-connection-string/)",

    "ENABLE_LLM_NARRATION": "false",
    "AZURE_OPENAI_ENDPOINT": "",
    "AZURE_OPENAI_API_KEY": "",
    "AZURE_OPENAI_DEPLOYMENT": "gpt-4o-mini",

    "VENDOR_ACCEPT_TIMEOUT_SECONDS": "120",
    "DISPATCHER_REVIEW_TIMEOUT_SECONDS": "300",
    "MAX_RETRY_ATTEMPTS": "2"
  }
}
