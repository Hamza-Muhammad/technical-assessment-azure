# Base URL of the deployed Part 2 backend (Azure Functions Flex Consumption).
# Fill in the real Function App URL after deploying infra/main.bicep + publishing
# (see backend/infra/DEPLOY.md) - this placeholder won't resolve on its own.
VITE_API_BASE_URL=https://<functionAppName>.azurewebsites.net/api

# When true, the app serves committed fixtures from src/mocks/ instead of calling
# VITE_API_BASE_URL. Kept true here so the repo stays demoable standalone (e.g. after
# the Azure free-trial credit expires) - flip to false once pointed at a real deployment.
VITE_USE_MOCKS=true
